# Experiment 5: Hypothesis Testing using t-distribution

from scipy import stats
import math

# Given data
sample_mean = 8
sample_std = 2
n = 20
alpha = 0.05

# 1. Calculate t-statistic
# Formula: t = sample_mean / (sample_std / sqrt(n))
t_stat = sample_mean / (sample_std / math.sqrt(n))

# 2. Degrees of freedom
df = n - 1

# 3. Calculate p-value (two-tailed)
p_value = 2 * (1 - stats.t.cdf(abs(t_stat), df=df))

print(f"T-statistic: {t_stat:.3f}")
print(f"P-value: {p_value:.5f}")

# 4. Decision
if p_value < alpha:
    print("Reject the null hypothesis: The mean heart rate increase is significantly different from zero.")
else:
    print("Fail to reject the null hypothesis: No significant difference from zero.")
